# Nakili faili hii kuwa ".env" (kwenye folder moja na email_helper.php)
# kisha jaza thamani halisi. USIWEKE ".env" kwenye Git/GitHub - iongeze
# kwenye .gitignore.
#
# KWENYE VPS faili hii HAITUMIKI. Production inapokea siri hizi kama
# env[...] ndani ya pool ya php-fpm, zinazotengenezwa kutoka
# /var/www/tech5g/private/secrets.env na /root/fix-secrets.sh.
#
# ⚠️ php-fpm HUKATAA env[] yenye thamani tupu (master mzima hushindwa
#    kuanza). Ukiwa huna thamani ya key fulani, IIONDOE KABISA badala
#    ya kuiacha tupu.

# ── SMTP (haya ndiyo majina sahihi - mailer.php inayapa kipaumbele) ──
# SMTP_HOST HAINA default. Ikikosekana, hakuna barua pepe itakayotumwa.
SMTP_HOST=timonsansibar.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=info@timonsansibar.com
SMTP_PASS=weka_password_hapa

# MAIL_FROM LAZIMA iwe anwani ya seva inayotuma. Namecheap hukataa
# From ya domain isiyo yao ("550 Your domain tech5g.co.tz is not
# allowed in header From"), na tech5g.co.tz kwa sasa haina MX hata
# kidogo - hivyo majibu ya support@ yangedondoka.
MAIL_FROM=info@timonsansibar.com

# ⚠️ USIWEKE NAFASI (space) kwenye thamani hii. secrets.env husomwa na
# cron kwa `set -a; . secrets.env`, na nafasi isiyo kwenye nukuu hufanya
# shell ijaribu KUENDESHA neno la pili ("5G: command not found") na
# thamani hukatika. Jina kamili la biashara lipo ndani ya barua pepe
# yenyewe (tech5gEmailTemplate), hivyo hapa tunatumia neno moja.
MAIL_FROM_NAME=Tech5G

# ── Majina ya ZAMANI (yanakubaliwa bado kama fallback pekee) ──
# Yalitumika wakati wa Gmail. Tumia SMTP_* hapo juu kwa mipangilio mipya.
# KUMBUKA: Gmail HAIKUBALI password ya akaunti - inahitaji App Password
# ya herufi 16 kutoka https://myaccount.google.com/apppasswords
#GMAIL_USER=tech5gwifi@gmail.com
#GMAIL_APP_PASSWORD=weka_app_password_ya_herufi_16_hapa
