#!/bin/bash
# =====================================================================
# tech5g-provision-peer <user_id> [--regenerate <peer_id>]
# ---------------------------------------------------------------------
# Inatoa tunnel ya WireGuard kwa reseller, kisha inachapisha JSON.
#
# HII NDIYO SEHEMU PEKEE inayoendeshwa kama root kwa niaba ya web app,
# kwa hiyo haiamini CHOCHOTE kinachotoka kwa PHP:
#   - Hoja zote zinakaguliwa kwa regex kali (namba pekee / mode moja tu).
#   - Inathibitisha YENYEWE kwenye database: mtumiaji yupo, ameidhinishwa,
#     na hajazidi kikomo cha routers cha mpango wake (subscription).
#   - PHP haichagui octet, funguo, wala peer ya kubadilisha - script pekee.
#   - flock inazuia maombi mawili kuchukua anwani ile ile.
#
# TUNNEL NYINGI KWA MTU MMOJA: kila router ya kimwili inahitaji tunnel yake
# (funguo yake na IP yake) - haziwezi kushirikiana. Kwa hiyo kikomo hapa ni
# max_routers ya mpango wake, siyo "moja kwa kila mtu".
#
# Usakinishaji:
#   install -o root -g root -m 750 tech5g-provision-peer /usr/local/sbin/
#   /etc/sudoers.d/tech5g-wg -> tech5g ALL=(root) NOPASSWD: /usr/local/sbin/tech5g-provision-peer
# =====================================================================
set -euo pipefail
umask 077

WG_IF="wg1"
WG_CONF="/etc/wireguard/${WG_IF}.conf"
WG_DIR="/etc/wireguard"
SUBNET="10.60.0"
VPS_IP="143.246.136.110"
WG_PORT="51821"
MAX_PEERS=200
LOCK="/var/lock/tech5g-wg.lock"
CREDS="/root/.tech5g-credentials"

jibu_kosa() { printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')"; exit 1; }

# ── 1. Hoja ──
UID_IN="${1:-}"
[[ "$UID_IN" =~ ^[0-9]{1,9}$ ]] || jibu_kosa "user_id si sahihi"
USER_ID=$((10#$UID_IN))
[ "$USER_ID" -gt 0 ] || jibu_kosa "user_id si sahihi"

MODE="${2:-new}"
PEER_ID=0
if [ "$MODE" = "--regenerate" ]; then
    PID_IN="${3:-}"
    [[ "$PID_IN" =~ ^[0-9]{1,9}$ ]] || jibu_kosa "peer_id si sahihi"
    PEER_ID=$((10#$PID_IN))
    [ "$PEER_ID" -gt 0 ] || jibu_kosa "peer_id si sahihi"
elif [ "$MODE" != "new" ]; then
    jibu_kosa "mode si sahihi"
fi

[ -f "$CREDS" ] || jibu_kosa "credentials hazipatikani"
# shellcheck disable=SC1090
set -a; . "$CREDS"; set +a
mysql_q() { mysql -h"${DB_HOST}" -u"${DB_USER}" -p"${DB_PASS}" "${DB_NAME}" -N -B -e "$1" 2>/dev/null; }

# ── 2. Thibitisha mtumiaji ──
INFO="$(mysql_q "SELECT status, role FROM users WHERE id=${USER_ID} LIMIT 1")"
[ -n "$INFO" ] || jibu_kosa "mtumiaji hayupo"
U_STATUS="$(printf '%s' "$INFO" | cut -f1)"
U_ROLE="$(printf '%s' "$INFO" | cut -f2)"
[ "$U_STATUS" = "approved" ] || jibu_kosa "akaunti bado haijaidhinishwa na admin"

exec 9>"$LOCK"
flock -w 10 9 || jibu_kosa "mfumo una shughuli nyingine - jaribu tena"

# ── 3. REGENERATE: badilisha funguo ya tunnel MAALUM (IP haibadiliki) ──
if [ "$MODE" = "--regenerate" ]; then
    # Umiliki unathibitishwa hapa: peer LAZIMA iwe ya mtumiaji huyu
    TUNNEL_IP="$(mysql_q "SELECT tunnel_ip FROM wg_peers WHERE id=${PEER_ID} AND user_id=${USER_ID} AND revoked_at IS NULL LIMIT 1")"
    [ -n "$TUNNEL_IP" ] || jibu_kosa "tunnel hiyo si yako au haipo"

    OLD_PUB="$(mysql_q "SELECT public_key FROM wg_peers WHERE id=${PEER_ID} LIMIT 1")"
    PRIV="$(wg genkey)"
    PUB="$(printf '%s' "$PRIV" | wg pubkey)"
    SRV_PUB="$(cat "${WG_DIR}/tech5g_server.pub")"

    cp -a "$WG_CONF" "${WG_CONF}.bak-$(date +%Y%m%d-%H%M%S)"
    python3 - "$WG_CONF" "$OLD_PUB" <<'PY'
import re, sys
path, oldpub = sys.argv[1], sys.argv[2]
txt = open(path).read()
blocks = re.split(r'(?=\n(?:#[^\n]*\n)?\[Peer\])', txt)
out = [b for b in blocks if oldpub not in b]
open(path, 'w').write(''.join(out))
PY
    {
      printf '\n# ---- reseller user_id=%s peer=%s (regenerated %s) ----\n' "$USER_ID" "$PEER_ID" "$(date -u +%FT%TZ)"
      printf '[Peer]\nPublicKey  = %s\nAllowedIPs = %s/32\n' "$PUB" "$TUNNEL_IP"
    } >> "$WG_CONF"

    wg syncconf "$WG_IF" <(wg-quick strip "$WG_IF") 2>/dev/null || jibu_kosa "imeshindikana kutekeleza WireGuard"

    ESC_PUB="$(printf '%s' "$PUB" | sed "s/'/''/g")"
    mysql_q "UPDATE wg_peers SET public_key='${ESC_PUB}', created_at=NOW() WHERE id=${PEER_ID}" >/dev/null

    printf '{"ok":true,"regenerated":true,"peer_id":%s,"tunnel_ip":"%s","private_key":"%s","server_pubkey":"%s","endpoint":"%s","port":"%s"}\n' \
        "$PEER_ID" "$TUNNEL_IP" "$PRIV" "$SRV_PUB" "$VPS_IP" "$WG_PORT"
    exit 0
fi

# ── 4. TUNNEL MPYA: kikomo kinatoka kwenye mpango wake ──
# Inaakisi getSubscriptionStatus() ya subscription_helper.php:
#   plan ipo      -> max_routers ya plan
#   trial bila plan -> 1
#   expired / hakuna -> 0
if [ "$U_ROLE" = "admin" ]; then
    RUHUSA=999
else
    SUB="$(mysql_q "SELECT s.status, IFNULL(p.max_routers,-1)
                      FROM subscriptions s
                      LEFT JOIN subscription_plans p ON p.id = s.plan_id
                     WHERE s.user_id=${USER_ID}
                     ORDER BY s.created_at DESC LIMIT 1")"
    if [ -z "$SUB" ]; then
        jibu_kosa "huna subscription - wasiliana na admin"
    fi
    S_STATUS="$(printf '%s' "$SUB" | cut -f1)"
    S_MAX="$(printf '%s' "$SUB" | cut -f2)"

    if [ "$S_STATUS" = "expired" ]; then
        jibu_kosa "Muda wa mpango wako umeisha. Fanya malipo ili kuendelea."
    elif [ "$S_MAX" -ge 0 ] 2>/dev/null; then
        RUHUSA="$S_MAX"
    elif [ "$S_STATUS" = "trial" ]; then
        RUHUSA=1
    else
        RUHUSA=0
    fi
fi

NAZO="$(mysql_q "SELECT COUNT(*) FROM wg_peers WHERE user_id=${USER_ID} AND revoked_at IS NULL")"
NAZO="${NAZO:-0}"

if [ "$NAZO" -ge "$RUHUSA" ]; then
    printf '{"ok":false,"limit":true,"have":%s,"allowed":%s,"error":"Umefikia kikomo cha routers (%s) kwa mpango wako. Fanya upgrade ili kuongeza zaidi."}\n' \
        "$NAZO" "$RUHUSA" "$RUHUSA"
    exit 0
fi

COUNT="$(grep -cE '^\[Peer\]' "$WG_CONF" || true)"
[ "${COUNT:-0}" -lt "$MAX_PEERS" ] || jibu_kosa "kikomo cha peers kimefikiwa"

OCTET=""
for i in $(seq 2 254); do
    if ! grep -qE "AllowedIPs\s*=\s*${SUBNET}\.${i}/32" "$WG_CONF" 2>/dev/null \
       && [ -z "$(mysql_q "SELECT 1 FROM wg_peers WHERE tunnel_ip='${SUBNET}.${i}' AND revoked_at IS NULL LIMIT 1")" ]; then
        OCTET="$i"; break
    fi
done
[ -n "$OCTET" ] || jibu_kosa "hakuna anwani iliyobaki kwenye subnet"
TUNNEL_IP="${SUBNET}.${OCTET}"

PRIV="$(wg genkey)"
PUB="$(printf '%s' "$PRIV" | wg pubkey)"
SRV_PUB="$(cat "${WG_DIR}/tech5g_server.pub")"

cp -a "$WG_CONF" "${WG_CONF}.bak-$(date +%Y%m%d-%H%M%S)"
{
  printf '\n# ---- reseller user_id=%s (self-service %s) ----\n' "$USER_ID" "$(date -u +%FT%TZ)"
  printf '[Peer]\nPublicKey  = %s\nAllowedIPs = %s/32\n' "$PUB" "$TUNNEL_IP"
} >> "$WG_CONF"

wg syncconf "$WG_IF" <(wg-quick strip "$WG_IF") 2>/dev/null || jibu_kosa "imeshindikana kutekeleza WireGuard"

ESC_PUB="$(printf '%s' "$PUB" | sed "s/'/''/g")"
mysql_q "INSERT INTO wg_peers (user_id, tunnel_ip, public_key) VALUES (${USER_ID}, '${TUNNEL_IP}', '${ESC_PUB}')" >/dev/null
NEW_ID="$(mysql_q "SELECT id FROM wg_peers WHERE tunnel_ip='${TUNNEL_IP}' LIMIT 1")"

printf '{"ok":true,"peer_id":%s,"tunnel_ip":"%s","private_key":"%s","server_pubkey":"%s","endpoint":"%s","port":"%s","have":%s,"allowed":%s}\n' \
    "${NEW_ID:-0}" "$TUNNEL_IP" "$PRIV" "$SRV_PUB" "$VPS_IP" "$WG_PORT" "$((NAZO+1))" "$RUHUSA"
